# =============================================================
# Aeroflutter — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ----------------------------------------------------------
# SUPABASE — Core connection details
# Found in: Supabase Dashboard → Settings → API
# ----------------------------------------------------------

# Your project's base URL. Safe to include in client-side code.
SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key. Safe to include in the mobile app and web dashboard.
# This key respects Row Level Security — users can only see their own data.
SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------
# SERVICE ROLE KEY — KEEP SECRET
# This key BYPASSES Row Level Security completely.
# Use ONLY in:
#   - Supabase Edge Functions (server-side)
#   - Admin scripts that run on your machine
# NEVER put this in the mobile app or web dashboard bundles.
# ----------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------
# GOOGLE CLOUD STORAGE — for selfie image uploads
# Used in Phase 5 (Edge Function for image upload)
# ----------------------------------------------------------

# GCS bucket name where selfie images are stored
GCS_BUCKET_NAME=aeroflutter-attendance-images

# Path to your GCS service account key JSON file
# (Edge Function environment only — never client-side)
GCS_SERVICE_ACCOUNT_KEY_PATH=/path/to/serviceAccountKey.json

# ----------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------

# Maximum distance in meters from signup location for check-in
GEOFENCE_RADIUS_METERS=50

# Minimum face similarity score (0.0 to 1.0) to accept a check-in
# 0.60 means 60% similarity — adjust based on ML Kit accuracy testing
FACE_SIMILARITY_THRESHOLD=0.60
